APP_NAME=EduConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# In production both URLs are the same HTTPS gateway origin.
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
AUTH_PASSWORD_RESET_EXPIRE=60
AUTH_PASSWORD_RESET_THROTTLE=60
AUTH_VERIFICATION_EXPIRE=60

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=educonnect
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
# Set to UTC only after verifying the provenance of a non-empty legacy schema.
DB_LEGACY_TIMESTAMP_TIMEZONE=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Production must use __Host-educonnect-session with HTTPS.
SESSION_COOKIE=educonnect-session
# Keep null in production so the session cookie remains host-only.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Production accepts exactly one gateway host and its matching full origin.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true

CACHE_STORE=database
CACHE_PREFIX=educonnect_cache

REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_CACHE_CONNECTION=cache

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_TIMEOUT=10
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
