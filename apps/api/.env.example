APP_NAME=EduConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# In production APP_URL and FRONTEND_URL are the same HTTPS student gateway.
# ADMIN_URL is a distinct HTTPS administration gateway.
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
AUTH_PASSWORD_RESET_EXPIRE=60
AUTH_PASSWORD_RESET_THROTTLE=60
AUTH_VERIFICATION_EXPIRE=60
# Keep true in production/CI. Set false only for local demos to auto-verify
# new registrations and skip the verify-email screen.
AUTH_REQUIRE_EMAIL_VERIFICATION=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=educonnect
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
# Set to UTC only after verifying the provenance of a non-empty legacy schema.
DB_LEGACY_TIMESTAMP_TIMEZONE=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Production must use __Host-educonnect-session with HTTPS.
SESSION_COOKIE=educonnect-session
# Keep null in production so the session cookie remains host-only.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Production accepts exactly the student and administration gateway hosts/origins.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

FILESYSTEM_DISK=local
RESOURCE_STORAGE_DISK=s3
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true

CACHE_STORE=database
CACHE_PREFIX=educonnect_cache

REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_CACHE_CONNECTION=cache

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_TIMEOUT=10
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
# Production must override this local default with a distinct environment-specific prefix.
AWS_ROOT=educonnect/local
AWS_USE_PATH_STYLE_ENDPOINT=false
# Bound server-side S3 calls while allowing a 25 MiB verification stream to finish.
AWS_CONNECT_TIMEOUT=5
AWS_REQUEST_TIMEOUT=60

# --- AI providers -----------------------------------------------------------
# Set OPENAI_API_KEY to enable AI features (intake classification, Copilot).
# Leave blank to run fully on the deterministic non-AI fallbacks.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Approved models per feature; change deliberately, never hardcode in code.
AI_INTAKE_MODEL=gpt-5-mini
AI_COPILOT_MODEL=gpt-5-mini
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=900
# gpt-5 reasoning models: keep visible output within the token budget.
AI_REASONING_EFFORT=minimal

# --- Observability (Phase 28) -----------------------------------------------
# Operational telemetry: AI-provider health, background-job health, captured
# server errors (durable, prunable), and rolling HTTP latency (cache histogram).
# It records only aggregate, redacted facts — never prompts, completions, or
# private content. Disable to make every recorder call a no-op.
TELEMETRY_ENABLED=true
TELEMETRY_RETENTION_DAYS=14
TELEMETRY_OVERVIEW_WINDOW_HOURS=24
TELEMETRY_HTTP_ENABLED=true
TELEMETRY_SLOW_REQUEST_MS=1000
TELEMETRY_HTTP_WINDOW_SECONDS=3600

# --- Reliability (Phase 28) -------------------------------------------------
# An intake item stuck in a transient state past this many seconds is treated
# as stranded (its worker was lost) and recovered by intake:recover-stranded.
INTAKE_STRANDED_AFTER_SECONDS=300
# Retryable failures are auto-requeued with exponential backoff, bounded by the
# attempt budget. Disable to keep retries strictly user-driven.
INTAKE_AUTO_RETRY_ENABLED=true
INTAKE_AUTO_RETRY_BASE_DELAY_SECONDS=60
INTAKE_AUTO_RETRY_MAX_DELAY_SECONDS=900
# AI-provider circuit breaker: open after this many consecutive failures, then
# short-circuit for the cooldown so a failing provider is not hammered.
AI_CIRCUIT_BREAKER_ENABLED=true
AI_CIRCUIT_BREAKER_THRESHOLD=5
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# --- Performance (Phase 28) -------------------------------------------------
# The published guidance bundle content is cached and self-invalidates on any
# content curation (a bumped content version); per-user viewer state is always
# applied fresh. The TTL only bounds staleness for scheduled visibility changes.
GUIDANCE_CACHE_ENABLED=true
GUIDANCE_CACHE_TTL_SECONDS=300
