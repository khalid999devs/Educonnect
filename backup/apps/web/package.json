{
  "name": "@educonnect/web",
  "version": "0.1.0",
  "private": true,
  "description": "EduConnect student application, marketing, onboarding, and Live Demo surface.",
  "prettier": "@educonnect/config/prettier",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
